# ==========================================================================
# Backend (apps/api) — variáveis de ambiente
# Copie para .env (ou use .env.hml / .env.prod + npm run env:hml|env:prod).
# NUNCA versione .env / .env.hml / .env.prod (estão no .gitignore).
# NÃO coloque usuário/senha da Sinqia aqui — credencial é digitada na tela.
# ==========================================================================

# Ambiente ativo: "hml" ou "prod" — usado para rótulo/aviso na UI e logs.
SINQIA_ENV=hml

# URL base da API Sinqia (troca entre HML e produção AQUI).
# Os hosts reais NÃO são versionados — peça à Sinqia/BRQ ou consulte a wiki
# interna da Opea, e preencha no seu .env.hml / .env.prod locais.
SINQIA_BASE_URL=https://<host-da-sinqia>
# Produção:
# SINQIA_BASE_URL=https://<host-de-producao-da-sinqia>

# Paths dos endpoints (relativos à base) — configuráveis caso mudem por ambiente.
SINQIA_LOGIN_PATH=/BJ21M05/user
SINQIA_CADASTRO_PATH=/BJ21M05/BJ21M05/BJ21SS0501F/cadastrarCliente

# Servidor local.
PORT=3333

# Origem permitida no CORS (front local do Vite).
WEB_ORIGIN=http://localhost:5173

# Comportamento do lote.
REQUEST_TIMEOUT_MS=30000
RETRY_COUNT=1
